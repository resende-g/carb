{
  "name": "portal-carb-prototipo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "node -e \"for (const key of ['VITE_SUPABASE_URL','VITE_SUPABASE_ANON_KEY']) if (!process.env[key]) throw new Error(key + ' obrigatória para deploy')\" && npm run build && npx wrangler@4.127.1 deploy",
    "deploy:check": "npm run build && npx wrangler@4.127.1 deploy --dry-run",
    "bootstrap:superadmin": "node scripts/bootstrap-superadmin.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
